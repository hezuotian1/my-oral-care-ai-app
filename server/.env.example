# ===== 服务 =====
PORT=3000
# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGIN=http://localhost:5173

# ===== 数据库 =====
MONGO_URI=mongodb://127.0.0.1:27017/oral_care

# ===== 鉴权 =====
# 请替换为一串足够长的随机字符串
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d

# ===== 智谱 GLM（多模态）=====
# 密钥只放这里，绝不写进源码、绝不提交到仓库
ZHIPU_API_KEY=your_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_VISION_MODEL=glm-4v
ZHIPU_CHAT_MODEL=glm-4
ZHIPU_TIMEOUT_MS=45000
# 置为 false 可完全走本地规则兜底（无网络/无 key 时）
ZHIPU_ENABLED=true
